# Environment Variables Configuration

# ===========================================
# Backend API Configuration
# ===========================================

# Backend API URL
# Development: http://localhost:8000
# Docker Compose: http://backend:8000 or /api (with nginx proxy)
# Production: https://api.yourdomain.com
# CI/CD: Use /api for relative URLs
REACT_APP_API_URL=http://localhost:8000

# ===========================================
# Application Environment
# ===========================================

# Environment: development | staging | production
REACT_APP_ENV=development

# Enable debug mode
REACT_APP_DEBUG=false

# ===========================================
# Docker Configuration
# ===========================================

# API Backend URL for nginx proxy (used in docker-compose)
# This is the internal Docker network URL
API_BACKEND_URL=http://backend:8000

# ===========================================
# Build Configuration
# ===========================================

# Generate source maps in production (true/false)
GENERATE_SOURCEMAP=false

# Skip preflight check (for CI environments)
SKIP_PREFLIGHT_CHECK=true

# ===========================================
# Optional: Feature Flags
# ===========================================

# REACT_APP_ENABLE_ANALYTICS=false
# REACT_APP_ENABLE_NOTIFICATIONS=true

